{
	"name": "obtion",
	"version": "0.1.1",
	"private": true,
	"description": "Project status at a glance (principle, to do, done, verification limits) plus wiki pages, databases, templates, relations, quick find and CSV/Markdown import and export. Everything stays in your vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "bun test",
		"lint": "eslint .",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"package": "node scripts/package-release.mjs",
		"version": "node version-bump.mjs"
	},
	"keywords": [
		"obsidian-plugin",
		"project-management",
		"status-board",
		"wiki",
		"database"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/bun": "^1.3.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Hakubisual/obtion.git"
	},
	"homepage": "https://github.com/Hakubisual/obtion"
}
